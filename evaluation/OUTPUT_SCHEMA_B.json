{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feedback",
    "error_interpretation",
    "remedial_qcm"
  ],
  "properties": {
    "feedback": {
      "type": "string",
      "minLength": 20
    },
    "error_interpretation": {
      "type": "string",
      "minLength": 10
    },
    "remedial_qcm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "options",
          "correct_option",
          "explanation",
          "target_objective_ids"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 8
          },
          "options": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 6,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "pattern": "^[A-F]$"
            }
          },
          "correct_option": {
            "type": "string",
            "pattern": "^[A-F]$"
          },
          "explanation": {
            "type": "string",
            "minLength": 8
          },
          "target_objective_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
